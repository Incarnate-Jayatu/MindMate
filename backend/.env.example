# Copy this file to ".env" (same folder) and fill in values. Never commit ".env".

# Default is SQLite. For Supabase/Postgres:
# DATABASE_URL=postgresql+psycopg://USER:PASS@HOST:5432/postgres

# AI tutor (optional; the app works without it).
# Free key from https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Or use Anthropic instead:
# ANTHROPIC_API_KEY=

# After deploying the frontend, allow it to call this backend (comma-separated, no trailing slash):
# CORS_ORIGINS=https://your-app.vercel.app
